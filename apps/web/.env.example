BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
# Optional; defaults to the official public BSC mainnet endpoint.
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional local DNS override when the network resolver incorrectly returns NXDOMAIN.
# Keep this unset on networks that resolve web3.binance.com normally.
# BINANCE_WEB3_DNS_SERVER=1.1.1.1
